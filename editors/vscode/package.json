{
  "name": "buzzard",
  "displayName": "Buzzard",
  "description": "Diagnostics, summaries, and block diagram previews for LabVIEW project files, from the buzzard language server.",
  "version": "0.1.0",
  "publisher": "buzzard",
  "private": true,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/jpoehnelt/buzzard.git",
    "directory": "editors/vscode"
  },
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Linters",
    "Visualization",
    "Other"
  ],
  "keywords": [
    "buzzard",
    "vi",
    "static analysis",
    "language server"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:**/*.vi",
    "workspaceContains:**/*.ctl",
    "workspaceContains:**/*.lvproj",
    "workspaceContains:**/*.lvlib",
    "workspaceContains:**/*.lvclass"
  ],
  "capabilities": {
    "virtualWorkspaces": false,
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In an untrusted workspace the `buzzard.path` setting of the workspace is ignored, so a workspace cannot choose which executable is run.",
      "restrictedConfigurations": [
        "buzzard.path"
      ]
    }
  },
  "contributes": {
    "configuration": {
      "title": "Buzzard",
      "properties": {
        "buzzard.path": {
          "type": "string",
          "default": "buzzard",
          "scope": "machine-overridable",
          "markdownDescription": "The `buzzard` executable. A bare name is looked up on `PATH`. A path that starts with `~` is taken from the home directory. A relative path with a directory in it is taken from the first workspace folder."
        },
        "buzzard.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "scope": "window",
          "description": "Trace the messages exchanged with the buzzard language server in the output panel."
        }
      }
    },
    "commands": [
      {
        "command": "buzzard.showSummary",
        "title": "Show File Summary",
        "category": "Buzzard"
      },
      {
        "command": "buzzard.showDiagram",
        "title": "Show Block Diagram",
        "category": "Buzzard"
      },
      {
        "command": "buzzard.findCallers",
        "title": "Find Callers",
        "category": "Buzzard"
      },
      {
        "command": "buzzard.restartServer",
        "title": "Restart Server",
        "category": "Buzzard"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "buzzard.showSummary",
          "when": "resourceScheme == file && resourceExtname =~ /^\\.(vi|ctl|lvproj|lvlib|lvclass)$/i",
          "group": "buzzard@1"
        },
        {
          "command": "buzzard.showDiagram",
          "when": "resourceScheme == file && resourceExtname =~ /^\\.(vi|ctl)$/i",
          "group": "buzzard@2"
        },
        {
          "command": "buzzard.findCallers",
          "when": "resourceScheme == file && resourceExtname =~ /^\\.(vi|ctl|lvproj|lvlib|lvclass)$/i",
          "group": "buzzard@3"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "buzzard.viewer",
        "displayName": "Buzzard Viewer",
        "selector": [
          {
            "filenamePattern": "*.vi"
          },
          {
            "filenamePattern": "*.ctl"
          }
        ],
        "priority": "option"
      }
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "compile": "npm run typecheck && node scripts/build.mjs",
    "lint": "eslint .",
    "test": "node scripts/build.mjs --tests && node --test \"out/unit/*.test.js\"",
    "test:integration": "npm run compile && node scripts/build.mjs --tests && node out/integration/runTest.js",
    "vscode:prepublish": "npm run typecheck && node scripts/build.mjs --production",
    "package": "vsce package --no-dependencies"
  },
  "dependencies": {
    "markdown-it": "15.0.3",
    "vscode-languageclient": "11.0.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/markdown-it": "14.2.0",
    "@types/node": "22.20.5",
    "@types/vscode": "1.91.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.1.1",
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2"
  },
  "overrides": {
    "minimatch": "11.0.8"
  }
}
