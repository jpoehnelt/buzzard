                "string"
              ]
            },
            "related": {
              "type": "array"
            },
            "severity": {
              "type": "string"
            }
          }
        },
        "description": "The problems that are shown, sorted by path, then code. `path` and `related` name files."
      },
      "summary": {
        "type": "object",
        "properties": {
          "by_code": {
            "type": "object",
