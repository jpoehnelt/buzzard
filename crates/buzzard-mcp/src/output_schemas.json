            },
            "packages": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "files": {
                    "type": "integer"
                  },
                  "found": {
                    "type": "integer"
                  },
                  "missing": {
                    "type": "integer"
                  },
