          "shown": {
            "type": "integer"
          },
          "truncated": {
            "type": "boolean"
          },
          "warnings": {
            "type": "integer"
          }
        },
        "description": "Counts over every problem, shown or not. `shown` is the length of `diagnostics`, and `truncated` says whether problems were left out."
      }
    }
