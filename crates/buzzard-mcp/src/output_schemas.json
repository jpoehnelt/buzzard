              "type": [
                "array",
                "integer"
              ],
              "items": {
                "type": "string"
              }
            }
          }
        },
        "description": "Machine-absolute links, sorted by target. `referrers` is a count with `detail` \"packages\" and the list of files with \"files\"."
      },
      "missing": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "target": {
              "type": "string"
            },
            "referrers": {
              "type": [
                "array",
                "integer"
              ],
              "items": {
                "type": "string"
              }
            }
          }
        },
        "description": "Relative links with no file at their location, in the shape of `absolute`."
      },
      "unparsed": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "message": {
              "type": "string"
            },
            "path": {
              "type": [
                "null",
                "string"
              ]
            }
          }
        },
        "description": "Files that could not be read or parsed, with the reason."
      },
      "unused_roots": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Names in `roots` that no link starts with. Absent when there are none."
      }
    }
  },
