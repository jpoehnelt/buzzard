  "buzzard_diagram": {
    "type": "object",
    "properties": {
      "path": {
        "type": "string",
        "description": "The file whose diagram was read."
      },
      "format": {
        "type": "string",
        "enum": [
          "markdown",
          "json",
          "mermaid",
          "dot",
          "svg"
        ],
        "description": "The format of the text."
      },
      "detail": {
        "type": "string",
        "enum": [
          "full",
          "summary",
          "frame",
          "nodes"
        ],
        "description": "What was returned: the whole diagram, its outline, one frame, or a range of nodes."
      },
      "outline": {
        "type": "object",
        "properties": {
          "callees": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "calls": {
                  "type": "integer"
                },
                "class": {
                  "type": "string"
                },
                "name": {
                  "type": [
                    "null",
                    "string"
                  ]
                }
              }
            }
          },
          "complete": {
            "type": "boolean"
          },
          "diagrams": {
            "type": "integer"
          },
          "losses": {
            "type": "array"
          },
          "node_classes": {
            "type": "object",
            "additionalProperties": {
              "type": "integer"
            }
          },
          "node_ids": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "integer"
            }
          },
          "nodes": {
            "type": "integer"
          },
          "structures": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "class": {
                  "type": "string"
                },
                "depth": {
                  "type": "integer"
                },
                "description": {
                  "type": "string"
                },
                "frames": {
                  "type": "array"
                },
                "parent": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "uid": {
                  "type": "integer"
                }
              }
            }
          },
          "terminals": {
            "type": "integer"
          },
          "wires": {
            "type": "integer"
          }
        },
        "description": "With `detail` \"summary\": counts, the range of node ids, node classes with counts, callees, the structures with their frames, and the kinds of loss the decoder recorded. `complete` is false when anything was lost."
      },
      "diagram": {
        "type": "object",
        "properties": {
          "root": {
            "$ref": "#/$defs/diagram"
          }
        },
        "description": "With `detail` \"full\" and format `json`: the whole decoded graph."
      },
      "structure": {
        "type": "integer",
        "description": "With `detail` \"frame\": the id of the structure."
      },
      "frame_index": {
        "type": "integer",
        "description": "With `detail` \"frame\": the index of the frame."
      },
      "frame": {
        "$ref": "#/$defs/diagram",
        "description": "With `detail` \"frame\": the nodes and wires of that frame."
      },
      "first_node": {
        "type": "integer",
        "description": "With `detail` \"nodes\": the first id of the range."
      },
      "last_node": {
        "type": "integer",
        "description": "With `detail` \"nodes\": the last id of the range."
      },
      "nodes": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/node"
        },
        "description": "With `detail` \"nodes\": the nodes of the range, each with everything inside it."
      }
    },
    "$defs": {
      "diagram": {
        "type": "object",
        "properties": {
          "uid": {
            "type": "integer"
          },
          "nodes": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/node"
            }
          },
          "wires": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "uid": {
                  "type": "integer"
                },
                "source": {
                  "type": "integer"
                },
                "sinks": {
                  "type": "array",
                  "items": {
                    "type": "integer"
                  }
                }
              }
            }
          },
          "losses": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "node": {
        "type": "object",
        "properties": {
          "uid": {
            "type": "integer"
          },
          "class": {
            "type": "string"
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "primitive": {
            "type": [
              "integer",
              "null"
            ]
          },
          "bounds": {
            "type": [
              "object",
              "null"
            ]
          },
          "terminals": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "uid": {
                  "type": "integer"
                },
                "bounds": {
                  "type": [
                    "object",
                    "null"
                  ]
                },
                "direction": {
                  "type": "string"
                },
                "wired": {
                  "type": "boolean"
                },
                "data_type": {},
                "dco": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "dco_class": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "numeric": {},
                "constant": {},
                "tunnel": {},
                "param": {
                  "type": "integer"
                }
              }
            }
          },
          "diagrams": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/diagram"
            }
          },
          "selector": {
            "type": "object"
          },
          "loop_info": {
            "type": "object"
          }
        }
      }
    }
  }
